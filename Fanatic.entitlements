<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Reading fan speed, die temperatures and power rails means opening the
	     AppleSMC IOKit service. The sandbox blocks that outright: verified by
	     building both ways, where a sandboxed build without this exception
	     cannot open the service at all and the whole app has nothing to show.
	     This entitlement is the only way to keep that access inside the
	     sandbox, and App Store review requires it to be justified. -->
	<key>com.apple.security.temporary-exception.iokit-user-client-class</key>
	<array>
		<string>AppleSMCClient</string>
	</array>
	<!-- The panel ranks apps by memory. The figure Activity Monitor shows
	     (phys_footprint, from proc_pid_rusage) is denied to sandboxed apps;
	     only the resident size gets through, and that leaves out compressed
	     and swapped pages, so under pressure it reads a fraction of the truth
	     and puts apps in the wrong order. This allows that one read-only call
	     and nothing else. The App Store is unlikely to accept it: without it,
	     the app falls back to the resident size rather than failing. -->
	<key>com.apple.security.temporary-exception.sbpl</key>
	<string>(allow process-info-rusage)</string>
</dict>
</plist>
